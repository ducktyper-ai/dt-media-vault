{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ducktyper-ai/dt-media-vault/blob/catalog-v1.0.0/docs/catalog/catalog-v1.schema.json",
  "title": "Media Vault catalog v1 draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/root_id"
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generated_at": {
      "$ref": "#/$defs/time"
    },
    "next_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/asset_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_revision",
    "generated_at",
    "next_after",
    "items"
  ],
  "$defs": {
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "not": {
        "pattern": "-00:00$|[\r\n]"
      }
    },
    "asset_id": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^blake3:[a-f0-9]{64}$"
    },
    "root_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$",
      "not": {
        "anyOf": [
          {
            "enum": [
              ".",
              ".."
            ]
          },
          {
            "pattern": "[^a-z0-9._-]"
          }
        ]
      }
    },
    "relative_path": {
      "type": "string",
      "description": "Slash-separated NFC path. Also check normalization and confinement at open time.",
      "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]+)*$",
      "not": {
        "pattern": "[\\\\\\x00-\\x1f\\x7f]"
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "root_id": {
          "$ref": "#/$defs/root_id"
        },
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "verification": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "offline",
            "unknown"
          ]
        },
        "verified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability_checked_at": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "root_id",
        "relative_path",
        "verification",
        "availability",
        "verified_at",
        "availability_checked_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "verified_at": {
                "$ref": "#/$defs/time"
              }
            }
          },
          "else": {
            "properties": {
              "verified_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "original_name": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "$ref": "#/$defs/time"
        },
        "root_id": {
          "$ref": "#/$defs/root_id"
        }
      },
      "required": [
        "original_name",
        "observed_at",
        "root_id"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "recorded_at_precision": {
          "enum": [
            "second",
            "minute",
            "day",
            "unknown"
          ]
        },
        "recorded_at_source": {
          "anyOf": [
            {
              "enum": [
                "recorder",
                "sidecar",
                "container",
                "folder",
                "file_mtime"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "recorded_at_precision",
        "recorded_at_source"
      ]
    },
    "video": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "codec": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "audio_track": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "index"
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "enum": [
            "video",
            "audio",
            "image",
            "other"
          ]
        },
        "recorded_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "shoot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "video": {
          "$ref": "#/$defs/video"
        },
        "audio_tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audio_track"
          }
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "track_role": {
          "enum": [
            "speaker",
            "program",
            "unknown"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "required": [
        "asset_id",
        "size_bytes",
        "media_type",
        "recorded_at",
        "duration_ms",
        "device_id",
        "project_id",
        "shoot_id",
        "speaker_ids",
        "locations",
        "metadata"
      ]
    }
  }
}
